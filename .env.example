# Copy to .env and fill in. Never commit the real .env.
BASE_URL=https://dev.reporty.sa
LOGIN_EMAIL=your-test-account@example.com
LOGIN_PASSWORD=changeme

# Sandbox WhatsApp destination number for any real-send test (sendReply,
# template test-send). NEVER point this at a real patient number.
TEST_WA_NUMBER=+6281266850960

# --- Maha "AI Instructions" suite (scenarios/maha-instructions/) ---
# Optional: skip the wizard-step-3 confirmation prompt phrase used by the
# runbook. Defaults to "نعم" per what was observed in real prod chat logs.
CONFIRM_PHRASE=نعم
# Real per-clinic values needed for some Section A/B tests to run
# meaningfully (they skip, or don't revert to baseline, without these).
TEST_DOCTOR_NAME=
TEST_CLINIC_NAME_ORIGINAL=
TEST_INSTAGRAM_ORIGINAL=
# Set to 1 to allow the (dangerous) reset-to-baseline test in Section B.
# Leave unset/0 unless you specifically mean to run it.
ALLOW_DESTRUCTIVE_RESET=0

# --- ETM suite (07-expected-text-mismatch.spec.ts) ---
# How many un-confirmed re-draft turns to send before confirming. The bug needs
# the model to build a stale draft of its own first, so <2 makes the test
# meaningless (it self-reports NEEDS_REVIEW + skips in that case). Raise it if a
# run reports "drift premise did not hold"; each extra round costs one real
# Maha round trip (~20-45s).
ETM_DRIFT_ROUNDS=3
# Upper bound for that loop. ETM_DRIFT_ROUNDS is a FLOOR: the drift phase keeps
# nudging until it has seen 2 materially different drafts (a real supersede),
# because whether Maha re-drafts or just re-explains the pending proposal is
# stochastic. A run that never gets a supersede reports UNABLE_TO_TEST rather
# than a meaningless pass — raise this if you see that often.
ETM_MAX_DRIFT_ROUNDS=6
